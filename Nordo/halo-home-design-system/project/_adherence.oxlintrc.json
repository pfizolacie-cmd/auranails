{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/controls/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/booking-app/**",
              "ui_kits/halo-home-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Poppins, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlarmCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|time|meta|on|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<AlarmCard> doesn't accept that prop. Declared props: title, time, meta, on, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArcSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|size|unit|caption|style|key|ref|className|style|children)$/]",
        "message": "<ArcSlider> doesn't accept that prop. Declared props: value, onChange, size, unit, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|full|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, full, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|glass|solid|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'glass' | 'solid' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClimateTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|on|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<ClimateTile> doesn't accept that prop. Declared props: value, unit, label, on, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorSwatchPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|value|onChange|size|style|key|ref|className|style|children)$/]",
        "message": "<ColorSwatchPicker> doesn't accept that prop. Declared props: colors, value, onChange, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeviceTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|image|on|onToggle|height|style|key|ref|className|style|children)$/]",
        "message": "<DeviceTile> doesn't accept that prop. Declared props: name, status, image, on, onToggle, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|radius|glow|children|style|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: tone, padding, radius, glow, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dim|solid)$/]",
        "message": "<GlassCard> tone must be one of 'light' | 'dim' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, icon, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|tone|active|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, tone, active, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:glass|solid|ember)$/]",
        "message": "<IconButton> tone must be one of 'glass' | 'solid' | 'ember'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|artist|art|playing|liked|count|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<MediaCard> doesn't accept that prop. Declared props: title, artist, art, playing, liked, count, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:backdrop|width|height|children|style|key|ref|className|style|children)$/]",
        "message": "<PhoneFrame> doesn't accept that prop. Declared props: backdrop, width, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:onBack|left|center|right|title|subtitle|style|key|ref|className|style|children)$/]",
        "message": "<ScreenHeader> doesn't accept that prop. Declared props: onBack, left, center, right, title, subtitle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:action|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: action, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|meta|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: icon, label, value, meta, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dim|solid)$/]",
        "message": "<StatTile> tone must be one of 'light' | 'dim' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepperButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|onClick|size|label|style|key|ref|className|style|children)$/]",
        "message": "<StepperButton> doesn't accept that prop. Declared props: direction, onClick, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepperButton'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<StepperButton> direction must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Switch> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: items, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TemperatureDial'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|now|size|label|unit|style|key|ref|className|style|children)$/]",
        "message": "<TemperatureDial> doesn't accept that prop. Declared props: value, min, max, now, size, label, unit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeRangeField'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|to|separator|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TimeRangeField> doesn't accept that prop. Declared props: from, to, separator, onChange, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
